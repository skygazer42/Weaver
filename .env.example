# 复制本文件为 .env 并填入真实密钥（.env 已在 .gitignore 中，请勿提交）。
# 本文件保留所有需要填写 API Key / 连接串的核心配置；其余高阶调优参数均在 common/config.py 中提供默认值。

# ===== 1. 模型 Provider（必填其一）=====
# 硅基流动 SiliconFlow（填 Key 即可开箱使用，默认 deepseek-ai/DeepSeek-V4.1-Flash）
SILICONFLOW_API_KEY=

# OpenAI / DeepSeek / 其他 OpenAI 兼容网关（留空 SILICONFLOW_API_KEY 时生效）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com/v1
PRIMARY_MODEL=deepseek-chat
REASONING_MODEL=deepseek-chat

# Anthropic（Claude，可选）
ANTHROPIC_API_KEY=

# Azure OpenAI（可选）
USE_AZURE=false
AZURE_API_KEY=
AZURE_ENDPOINT=
AZURE_API_VERSION=2025-03-01-preview

# ===== 2. 搜索引擎密钥（Web / Deep Research 推荐至少填 TAVILY_API_KEY）=====
# 引擎优先级（逗号分隔），未填 Key 的引擎会自动跳过
SEARCH_ENGINES=tavily
TAVILY_API_KEY=
SERPER_API_KEY=
BRAVE_API_KEY=
SERPAPI_API_KEY=
BING_API_KEY=
EXA_API_KEY=
FIRECRAWL_API_KEY=
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=

# ===== 3. 沙箱、语音与长期记忆密钥（按需填写）=====
# E2B 云端沙箱（Python 代码执行、CSV 分析、浏览器自动化、文档生成）
E2B_API_KEY=

# 本地免费 Docker 沙盒（默认关闭；未填 E2B_API_KEY 时可按需开启，复用 shell/files/python 工具接口）
# ENABLE_DOCKER_SANDBOX=true
# DOCKER_SANDBOX_IMAGE=python:3.12-slim
# DOCKER_SANDBOX_CPUS=1.0
# DOCKER_SANDBOX_MEMORY=512m
# DOCKER_SANDBOX_NETWORK_ENABLED=false

# 阿里云 DashScope（语音识别 ASR / 语音合成 TTS）
DASHSCOPE_API_KEY=

# 长期记忆（可选）
ENABLE_MEMORY=false
MEM0_API_KEY=
MEMORY_STORE_BACKEND=memory
MEMORY_STORE_URL=

# ===== 4. 数据库与 MCP（按需填写）=====
# PostgreSQL 连接串（留空使用内存 checkpointer；/workspace 任务持久化需配置）
DATABASE_URL=

# MCP 工具桥接（推荐使用 Web 设置页可视化管理，自动持久化到 config/mcp.json；详见 docs/mcp.md）
# 如需在容器/无界面环境通过环境变量覆盖，可取消注释（支持标准 mcpServers 或平铺 JSON，自动识别 streamable_http / stdio / sse）
# ENABLE_MCP=true
# MCP_CONFIG_PATH=config/mcp.json
# MCP_SERVERS={}

# ===== 5. 服务、端口与安全鉴权 =====
APP_ENV=dev
DEBUG=true
PORT=8001
# 修改 PORT 时请同步更新 WEAVER_BASE_URL 与 web/.env.local 的 NEXT_PUBLIC_API_URL
WEAVER_BASE_URL=http://127.0.0.1:8001
# Windows 若 3000 端口被保留，前端默认使用 3100
CORS_ORIGINS=http://localhost:3000,http://localhost:3100

# 公开部署内网鉴权密钥（留空不启用；开启后 /api/* 需带 Bearer 或 X-API-Key，详见 docs/deployment.md）
WEAVER_INTERNAL_API_KEY=
WEAVER_AUTH_USER_HEADER=X-Weaver-User

# ===== 说明 =====
# 更多高阶调优参数（深搜轮次、网页抓取、质量门禁、限流、日志、审批开关等）均有内置默认值，
# 需要自定义时请参考 docs/configuration.md 与 common/config.py。
