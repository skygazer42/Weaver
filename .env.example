# 复制本文件为 .env 并填入真实密钥（.env 已在 .gitignore 中，请勿提交）。
# 所有高阶调优参数均在 common/config.py 中提供默认值，无需全部填写。

# ===== 1. 模型配置（二选一即可运行）=====
# 方式 A：硅基流动（推荐，填 Key 即可使用，默认模型 deepseek-ai/DeepSeek-V4.1-Flash）
SILICONFLOW_API_KEY=

# 方式 B：OpenAI / DeepSeek / 其他 OpenAI 兼容网关（留空 SILICONFLOW_API_KEY 时生效）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com/v1
PRIMARY_MODEL=deepseek-chat
REASONING_MODEL=deepseek-chat

# 其他模型网关（可选）
# ANTHROPIC_API_KEY=
# USE_AZURE=false
# AZURE_API_KEY=
# AZURE_ENDPOINT=
# AZURE_API_VERSION=2025-03-01-preview

# ===== 2. 搜索与沙箱（按需配置）=====
# 联网搜索与 Deep Research（推荐填写）
TAVILY_API_KEY=
# 多引擎聚合优先级，可选：tavily,serper,brave,serpapi,bing,google_cse,exa,firecrawl
# SEARCH_ENGINES=tavily

# E2B 云端沙箱（用于 Python 代码执行、CSV 分析、浏览器自动化与文档生成）
E2B_API_KEY=

# ===== 3. 服务与端口 =====
PORT=8001
DEBUG=true
# Windows 若 3000 端口被系统保留，前端默认运行在 3100
CORS_ORIGINS=http://localhost:3000,http://localhost:3100
# 修改 PORT 时，请同步更新 web/.env.local 中的 NEXT_PUBLIC_API_URL
# WEAVER_BASE_URL=http://127.0.0.1:8001
# WEAVER_RELOAD=false

# ===== 4. 可选能力（按需取消注释）=====
# PostgreSQL 持久化（留空则使用内存状态，/workspace 任务持久化需配置）
# DATABASE_URL=postgresql://user:pass@localhost:5432/weaver

# MCP 工具桥接（详见 docs/mcp.md）
# ENABLE_MCP=false
# MCP_SERVERS={}

# 长期记忆
# ENABLE_MEMORY=false
# MEMORY_STORE_BACKEND=memory
# MEMORY_STORE_URL=
# MEM0_API_KEY=

# 语音识别 / 语音合成（阿里云 DashScope）
# DASHSCOPE_API_KEY=

# 人工审批与质量控制
# TOOL_APPROVAL=false
# HUMAN_REVIEW=false
# TOOL_CALL_LIMIT=12

# 公开部署加固（详见 docs/deployment.md）
# APP_ENV=dev
# WEAVER_INTERNAL_API_KEY=
# WEAVER_AUTH_USER_HEADER=X-Weaver-User
# RATE_LIMIT_ENABLED=true

# 更多高阶参数（深搜轮次/聚合搜索/网页抓取/质量门禁/日志等）见 docs/configuration.md 与 common/config.py
