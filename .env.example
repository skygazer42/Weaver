# ===== 模型 Provider=====
# 硅基流动 SiliconFlow
SILICONFLOW_API_KEY=

# OpenAI / DeepSeek / 其他 OpenAI 兼容网关
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com/v1
PRIMARY_MODEL=deepseek-chat
REASONING_MODEL=deepseek-chat


# ===== 2搜索引擎密钥（Web / Deep Research 推荐至少填 TAVILY_API_KEY）=====
SEARCH_ENGINES=tavily
TAVILY_API_KEY=
SERPER_API_KEY=
BRAVE_API_KEY=
SERPAPI_API_KEY=
BING_API_KEY=
EXA_API_KEY=
FIRECRAWL_API_KEY=
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=

# =====  沙箱、语音与长期记忆密钥（按需填写）=====
# E2B 云端沙箱（Python 代码执行、CSV 分析、浏览器自动化、Deep Search 实时浏览器预览）
E2B_API_KEY=
# E2B 浏览器沙箱模板 ID（Deep Search 实时浏览器预览必需，官方推荐 desktop，内置 Chrome 且兼容新安全访问）
SANDBOX_TEMPLATE_BROWSER=desktop
SANDBOX_ALLOW_INTERNET=true
DEEPSEARCH_VISUALIZE_BROWSER=true

# 本地 Docker 沙盒（默认关闭；未填 E2B_API_KEY 时可按需开启）
# ENABLE_DOCKER_SANDBOX=true
# DOCKER_SANDBOX_IMAGE=python:3.12-slim
# DOCKER_SANDBOX_CPUS=1.0
# DOCKER_SANDBOX_MEMORY=512m
# DOCKER_SANDBOX_NETWORK_ENABLED=false

# 阿里云 DashScope（语音识别 ASR / 语音合成 TTS）
DASHSCOPE_API_KEY=

# 长期记忆（可选）
ENABLE_MEMORY=false
MEM0_API_KEY=
MEMORY_STORE_BACKEND=memory
MEMORY_STORE_URL=


# ===== 5. 服务、端口与安全鉴权 =====
APP_ENV=dev
DEBUG=true
PORT=8001
# 修改 PORT 时请同步更新 WEAVER_BASE_URL 与 web/.env.local 的 NEXT_PUBLIC_API_URL
WEAVER_BASE_URL=http://127.0.0.1:8001
# Windows 若 3000 端口被保留，前端默认使用 3100
CORS_ORIGINS=http://localhost:3000,http://localhost:3100

# 公开部署内网鉴权密钥（留空不启用；开启后 /api/* 需带 Bearer 或 X-API-Key，详见 docs/deployment.md）
WEAVER_INTERNAL_API_KEY=
WEAVER_AUTH_USER_HEADER=X-Weaver-User

